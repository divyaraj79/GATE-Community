<%- include('partials/header', { title: 'About - GATE Question Bank', active: 'about' }) %>

<div class="container py-5">
    <!-- Hero Section -->
    <div class="row mb-5">
        <div class="col text-center">
            <h1 class="display-4 fw-bold mb-4">
                <i class="fas fa-info-circle text-primary me-3"></i>
                About GATE Question Bank
            </h1>
            <p class="lead text-muted">
                Empowering GATE aspirants through community-driven learning and high-quality question sharing
            </p>
        </div>
    </div>

    <!-- Mission Section -->
    <div class="row mb-5">
        <div class="col-lg-8 mx-auto">
            <div class="card">
                <div class="card-body text-center p-5">
                    <h2 class="mb-4">Our Mission</h2>
                    <p class="lead">
                        To create the most comprehensive and accessible repository of GATE exam questions, 
                        fostering a collaborative learning environment where students and educators can share 
                        knowledge and help each other succeed.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="text-center mb-5">What Makes Us Different</h2>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-card text-center h-100">
                <div class="feature-icon mb-3">
                    <i class="fas fa-users fa-3x text-primary"></i>
                </div>
                <h4>Community-Driven</h4>
                <p class="text-muted">
                    Questions are contributed by real students, educators, and GATE experts, 
                    ensuring diverse perspectives and practical relevance.
                </p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-card text-center h-100">
                <div class="feature-icon mb-3">
                    <i class="fas fa-check-circle fa-3x text-success"></i>
                </div>
                <h4>Quality Assured</h4>
                <p class="text-muted">
                    All questions undergo review processes to maintain high standards and 
                    accuracy in content and explanations.
                </p>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="feature-card text-center h-100">
                <div class="feature-icon mb-3">
                    <i class="fas fa-tags fa-3x text-info"></i>
                </div>
                <h4>Well Organized</h4>
                <p class="text-muted">
                    Questions are categorized by subject, difficulty level, and year, 
                    making it easy to find exactly what you need.
                </p>
            </div>
        </div>
    </div>

    <!-- How It Works Section -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="text-center mb-5">How It Works</h2>
        </div>
        <div class="col-lg-10 mx-auto">
            <div class="row">
                <div class="col-md-3 text-center mb-4">
                    <div class="step-number mb-3">
                        <span class="badge bg-primary rounded-circle p-3">1</span>
                    </div>
                    <h5>Join Community</h5>
                    <p class="text-muted small">Create your account and become part of our growing community</p>
                </div>
                <div class="col-md-3 text-center mb-4">
                    <div class="step-number mb-3">
                        <span class="badge bg-primary rounded-circle p-3">2</span>
                    </div>
                    <h5>Browse Questions</h5>
                    <p class="text-muted small">Explore questions by category, difficulty, or search for specific topics</p>
                </div>
                <div class="col-md-3 text-center mb-4">
                    <div class="step-number mb-3">
                        <span class="badge bg-primary rounded-circle p-3">3</span>
                    </div>
                    <h5>Learn & Practice</h5>
                    <p class="text-muted small">Study with detailed explanations and practice with various difficulty levels</p>
                </div>
                <div class="col-md-3 text-center mb-4">
                    <div class="step-number mb-3">
                        <span class="badge bg-primary rounded-circle p-3">4</span>
                    </div>
                    <h5>Contribute</h5>
                    <p class="text-muted small">Share your knowledge by adding questions and helping others</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Section -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card bg-primary text-white">
                <div class="card-body text-center p-5">
                    <h2 class="mb-4">Platform Statistics</h2>
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <div class="stat-item">
                                <h3 class="fw-bold">1000+</h3>
                                <p class="mb-0">Questions</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="stat-item">
                                <h3 class="fw-bold">500+</h3>
                                <p class="mb-0">Active Users</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="stat-item">
                                <h3 class="fw-bold">20+</h3>
                                <p class="mb-0">Categories</p>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="stat-item">
                                <h3 class="fw-bold">24/7</h3>
                                <p class="mb-0">Availability</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Team Section -->
    <div class="row mb-5">
        <div class="col-12">
            <h2 class="text-center mb-5">Our Team</h2>
        </div>
        <div class="col-lg-8 mx-auto">
            <div class="row">
                <div class="col-md-6 text-center mb-4">
                    <div class="team-member">
                        <div class="team-avatar mb-3">
                            <i class="fas fa-user-circle fa-4x text-primary"></i>
                        </div>
                        <h5>Development Team</h5>
                        <p class="text-muted">
                            Dedicated developers working to improve the platform and user experience
                        </p>
                    </div>
                </div>
                <div class="col-md-6 text-center mb-4">
                    <div class="team-member">
                        <div class="team-avatar mb-3">
                            <i class="fas fa-user-circle fa-4x text-success"></i>
                        </div>
                        <h5>Community Moderators</h5>
                        <p class="text-muted">
                            Experienced educators and GATE experts ensuring content quality
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="row">
        <div class="col text-center">
            <div class="card bg-light">
                <div class="card-body p-5">
                    <h3 class="mb-3">Ready to Get Started?</h3>
                    <p class="lead mb-4">
                        Join thousands of GATE aspirants and start your preparation journey today!
                    </p>
                    <div class="d-flex justify-content-center gap-3 flex-wrap">
                        <a href="/users/register" class="btn btn-primary btn-lg">
                            <i class="fas fa-user-plus me-2"></i>Join Community
                        </a>
                        <a href="/questions" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-question-circle me-2"></i>Browse Questions
                        </a>
                        <a href="/contact" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-envelope me-2"></i>Contact Us
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.feature-card {
    padding: 2rem;
    border: 1px solid #e9ecef;
    border-radius: 0.5rem;
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
}

.feature-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.step-number .badge {
    font-size: 1.5rem;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.stat-item h3 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
}

.team-avatar {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
}
</style>

<%- include('partials/footer') %>
