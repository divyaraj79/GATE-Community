<%- include('../partials/header', { title: 'Categories - GATE Question Bank', active: 'categories' }) %>

<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4 fw-bold">
                <i class="fas fa-tags text-primary me-3"></i>
                Subject Categories
            </h1>
            <p class="lead text-muted">Explore questions organized by subject areas</p>
        </div>
    </div>

    <div class="row">
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="category-card h-100">
                        <div class="card-body text-center">
                            <div class="category-icon mb-3">
                                <i class="<%= category.icon || 'fas fa-tag' %> fa-3x" 
                                   style="color: <%= category.color || '#007bff' %>"></i>
                            </div>
                            <h5 class="card-title"><%= category.name %></h5>
                            <p class="card-text text-muted">
                                <%= category.description || 'No description available' %>
                            </p>
                            
                            <div class="category-stats mb-3">
                                <span class="badge bg-primary me-2">
                                    <i class="fas fa-question-circle me-1"></i>
                                    <%= category.questionCount || 0 %> Questions
                                </span>
                                <% if (category.subcategories && category.subcategories.length > 0) { %>
                                    <span class="badge bg-info">
                                        <i class="fas fa-layer-group me-1"></i>
                                        <%= category.subcategories.length %> Subcategories
                                    </span>
                                <% } %>
                            </div>

                            <div class="d-grid">
                                <a href="/categories/<%= category.slug %>" class="btn btn-outline-primary">
                                    <i class="fas fa-arrow-right me-2"></i>Explore Category
                                </a>
                            </div>

                            <% if (category.subcategories && category.subcategories.length > 0) { %>
                                <div class="mt-3">
                                    <small class="text-muted">Subcategories:</small>
                                    <div class="mt-2">
                                        <% category.subcategories.forEach(subcategory => { %>
                                            <a href="/categories/<%= subcategory.slug %>" 
                                               class="badge bg-light text-dark text-decoration-none me-1">
                                                <%= subcategory.name %>
                                            </a>
                                        <% }) %>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center py-5">
                <i class="fas fa-tags fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No categories available</h4>
                <p class="text-muted">Categories will be added by administrators</p>
            </div>
        <% } %>
    </div>

    <!-- Category Statistics -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card bg-light">
                <div class="card-body text-center">
                    <h5 class="card-title mb-3">Category Overview</h5>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="stat-item">
                                <i class="fas fa-tags fa-2x text-primary mb-2"></i>
                                <h4 class="fw-bold text-primary"><%= categories ? categories.length : 0 %></h4>
                                <p class="text-muted mb-0">Total Categories</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-item">
                                <i class="fas fa-question-circle fa-2x text-success mb-2"></i>
                                <h4 class="fw-bold text-success">
                                    <%= categories ? categories.reduce((total, cat) => total + (cat.questionCount || 0), 0) : 0 %>
                                </h4>
                                <p class="text-muted mb-0">Total Questions</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-item">
                                <i class="fas fa-layer-group fa-2x text-info mb-2"></i>
                                <h4 class="fw-bold text-info">
                                    <%= categories ? categories.reduce((total, cat) => total + (cat.subcategories ? cat.subcategories.length : 0), 0) : 0 %>
                                </h4>
                                <p class="text-muted mb-0">Subcategories</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.category-card {
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    border: 1px solid #e9ecef;
}

.category-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.category-icon {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.stat-item {
    padding: 1rem;
}

.stat-item i {
    display: block;
}
</style>

<%- include('../partials/footer') %>
