<%- include('../partials/header', { title: category.name + ' - GATE Question Bank', active: 'categories' }) %>

<div class="container py-5">
    <!-- Category Header -->
    <div class="row mb-4">
        <div class="col">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/categories">Categories</a></li>
                    <li class="breadcrumb-item active" aria-current="page"><%= category.name %></li>
                </ol>
            </nav>
            
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h1 class="display-4 fw-bold">
                        <i class="<%= category.icon || 'fas fa-tag' %> text-primary me-3"></i>
                        <%= category.name %>
                    </h1>
                    <p class="lead text-muted"><%= category.description || 'No description available' %></p>
                    
                    <div class="category-meta">
                        <span class="badge bg-primary me-2">
                            <i class="fas fa-question-circle me-1"></i>
                            <%= questions.length %> Questions
                        </span>
                        <% if (category.year) { %>
                            <span class="badge bg-info me-2">
                                <i class="fas fa-calendar me-1"></i>
                                <%= category.year %>
                            </span>
                        <% } %>
                        <% if (category.isActive) { %>
                            <span class="badge bg-success">
                                <i class="fas fa-check-circle me-1"></i>
                                Active
                            </span>
                        <% } %>
                    </div>
                </div>
                
                <div class="text-end">
                    <% if (user) { %>
                        <a href="/questions/create?category=<%= category._id %>" class="btn btn-primary btn-lg">
                            <i class="fas fa-plus me-2"></i>Add Question
                        </a>
                    <% } else { %>
                        <a href="/users/login" class="btn btn-primary btn-lg">
                            <i class="fas fa-sign-in-alt me-2"></i>Login to Add
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Subcategories -->
    <% if (subcategories && subcategories.length > 0) { %>
        <div class="row mb-4">
            <div class="col">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="fas fa-layer-group text-info me-2"></i>
                            Subcategories
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <% subcategories.forEach(subcategory => { %>
                                <div class="col-md-4 mb-2">
                                    <a href="/categories/<%= subcategory.slug %>" 
                                       class="btn btn-outline-info btn-sm w-100 text-start">
                                        <i class="<%= subcategory.icon || 'fas fa-tag' %> me-2"></i>
                                        <%= subcategory.name %>
                                        <span class="badge bg-secondary ms-auto">
                                            <%= subcategory.questionCount || 0 %>
                                        </span>
                                    </a>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Search and Filter -->
    <div class="row mb-4">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <form action="/search" method="GET" class="row g-3">
                        <input type="hidden" name="category" value="<%= category._id %>">
                        <div class="col-md-6">
                            <input type="text" class="form-control" name="q" placeholder="Search within <%= category.name %>..." 
                                   value="<%= typeof query !== 'undefined' ? query : '' %>">
                        </div>
                        <div class="col-md-4">
                            <select class="form-select" name="difficulty">
                                <option value="">All Difficulties</option>
                                <option value="Easy" <%= (typeof difficulty !== 'undefined' && difficulty === 'Easy') ? 'selected' : '' %>>Easy</option>
                                <option value="Medium" <%= (typeof difficulty !== 'undefined' && difficulty === 'Medium') ? 'selected' : '' %>>Medium</option>
                                <option value="Hard" <%= (typeof difficulty !== 'undefined' && difficulty === 'Hard') ? 'selected' : '' %>>Hard</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Search
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Questions List -->
    <div class="row">
        <% if (questions && questions.length > 0) { %>
            <% questions.forEach(question => { %>
                <div class="col-lg-6 mb-4">
                    <div class="question-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-<%= question.difficulty === 'Easy' ? 'success' : question.difficulty === 'Medium' ? 'warning' : 'danger' %>">
                                    <%= question.difficulty %>
                                </span>
                                <small class="text-muted">
                                    <i class="fas fa-eye me-1"></i><%= question.views || 0 %>
                                </small>
                            </div>
                            <h5 class="card-title">
                                <a href="/questions/<%= question._id %>" class="text-decoration-none stretched-link">
                                    <%= question.title %>
                                </a>
                            </h5>
                            <p class="card-text text-muted">
                                <%= question.content.substring(0, 150) %>...
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="question-meta">
                                    <small class="text-muted">
                                        <i class="fas fa-user me-1"></i>
                                        <%= question.author ? question.author.username : 'Anonymous' %>
                                    </small>
                                    <% if (question.year) { %>
                                        <small class="text-muted ms-2">
                                            <i class="fas fa-calendar me-1"></i><%= question.year %>
                                        </small>
                                    <% } %>
                                </div>
                                <small class="text-muted">
                                    <%= new Date(question.createdAt).toLocaleDateString() %>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center py-5">
                <i class="fas fa-question-circle fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No questions in this category yet</h4>
                <p class="text-muted">Be the first to add a question to <%= category.name %>!</p>
                <% if (user) { %>
                    <a href="/questions/create?category=<%= category._id %>" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add First Question
                    </a>
                <% } else { %>
                    <a href="/users/register" class="btn btn-primary">
                        <i class="fas fa-user-plus me-2"></i>Join & Contribute
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
        <div class="row mt-4">
            <div class="col">
                <nav aria-label="Category questions pagination">
                    <ul class="pagination justify-content-center">
                        <% if (currentPage > 1) { %>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=<%= limit %>">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </a>
                            </li>
                        <% } %>
                        
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                <a class="page-link" href="?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
                            </li>
                        <% } %>
                        
                        <% if (currentPage < totalPages) { %>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=<%= limit %>">
                                    Next <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        </div>
    <% } %>

    <!-- Related Categories -->
    <div class="row mt-5">
        <div class="col">
            <div class="card bg-light">
                <div class="card-body text-center">
                    <h5 class="card-title mb-3">Explore Other Categories</h5>
                    <div class="d-flex justify-content-center flex-wrap gap-2">
                        <a href="/categories" class="btn btn-outline-primary">
                            <i class="fas fa-tags me-2"></i>All Categories
                        </a>
                        <a href="/questions" class="btn btn-outline-success">
                            <i class="fas fa-question-circle me-2"></i>All Questions
                        </a>
                        <a href="/" class="btn btn-outline-info">
                            <i class="fas fa-home me-2"></i>Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.question-card {
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    border: 1px solid #e9ecef;
}

.question-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.category-meta .badge {
    font-size: 0.9rem;
}
</style>

<%- include('../partials/footer') %>
