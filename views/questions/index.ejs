<%- include('../partials/header', { title: 'All Questions - GATE Question Bank', active: 'questions' }) %>

<div class="container py-5">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4 fw-bold">
                <i class="fas fa-question-circle text-primary me-3"></i>
                All Questions
            </h1>
            <p class="lead text-muted">Browse through our collection of GATE exam questions</p>
        </div>
        <div class="col-auto">
            <% if (user) { %>
                <a href="/questions/create" class="btn btn-primary btn-lg">
                    <i class="fas fa-plus me-2"></i>Add Question
                </a>
            <% } else { %>
                <a href="/users/login" class="btn btn-primary btn-lg">
                    <i class="fas fa-sign-in-alt me-2"></i>Login to Add
                </a>
            <% } %>
        </div>
    </div>

    <!-- Search and Filter Section -->
    <div class="row mb-4">
        <div class="col">
            <div class="card">
                <div class="card-body">
                    <form action="/search" method="GET" class="row g-3">
                        <div class="col-md-4">
                            <input type="text" class="form-control" name="q" placeholder="Search questions..." value="<%= typeof query !== 'undefined' ? query : '' %>">
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" name="category">
                                <option value="">All Categories</option>
                                <!-- Categories will be populated here -->
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" name="difficulty">
                                <option value="">All Difficulties</option>
                                <option value="Easy" <%= (typeof difficulty !== 'undefined' && difficulty === 'Easy') ? 'selected' : '' %>>Easy</option>
                                <option value="Medium" <%= (typeof difficulty !== 'undefined' && difficulty === 'Medium') ? 'selected' : '' %>>Medium</option>
                                <option value="Hard" <%= (typeof difficulty !== 'undefined' && difficulty === 'Hard') ? 'selected' : '' %>>Hard</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fas fa-search me-2"></i>Search
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Questions List -->
    <div class="row">
        <% if (questions && questions.length > 0) { %>
            <% questions.forEach(question => { %>
                <div class="col-lg-6 mb-4">
                    <div class="question-card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-<%= question.difficulty === 'Easy' ? 'success' : question.difficulty === 'Medium' ? 'warning' : 'danger' %>">
                                    <%= question.difficulty %>
                                </span>
                                <small class="text-muted">
                                    <i class="fas fa-eye me-1"></i><%= question.views || 0 %>
                                </small>
                            </div>
                            <h5 class="card-title">
                                <a href="/questions/<%= question._id %>" class="text-decoration-none stretched-link">
                                    <%= question.title %>
                                </a>
                            </h5>
                            <p class="card-text text-muted">
                                <%= question.content.substring(0, 150) %>...
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <div class="question-meta">
                                    <span class="badge bg-secondary me-2">
                                        <i class="fas fa-tag me-1"></i><%= question.category ? question.category.name : 'Uncategorized' %>
                                    </span>
                                    <small class="text-muted">
                                        <i class="fas fa-user me-1"></i><%= question.author ? question.author.username : 'Anonymous' %>
                                    </small>
                                </div>
                                <small class="text-muted">
                                    <%= new Date(question.createdAt).toLocaleDateString() %>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center py-5">
                <i class="fas fa-question-circle fa-3x text-muted mb-3"></i>
                <h4 class="text-muted">No questions found</h4>
                <p class="text-muted">Try adjusting your search criteria or be the first to add a question!</p>
                <% if (user) { %>
                    <a href="/questions/create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add Question
                    </a>
                <% } else { %>
                    <a href="/users/register" class="btn btn-primary">
                        <i class="fas fa-user-plus me-2"></i>Join & Contribute
                    </a>
                <% } %>
            </div>
        <% } %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
        <div class="row mt-4">
            <div class="col">
                <nav aria-label="Questions pagination">
                    <ul class="pagination justify-content-center">
                        <% if (currentPage > 1) { %>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage - 1 %>&limit=<%= limit %>">
                                    <i class="fas fa-chevron-left"></i> Previous
                                </a>
                            </li>
                        <% } %>
                        
                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                                <a class="page-link" href="?page=<%= i %>&limit=<%= limit %>"><%= i %></a>
                            </li>
                        <% } %>
                        
                        <% if (currentPage < totalPages) { %>
                            <li class="page-item">
                                <a class="page-link" href="?page=<%= currentPage + 1 %>&limit=<%= limit %>">
                                    Next <i class="fas fa-chevron-right"></i>
                                </a>
                            </li>
                        <% } %>
                    </ul>
                </nav>
            </div>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
