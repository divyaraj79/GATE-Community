<%- include('../partials/header', { title: question.title + ' - GATE Question Bank', active: 'questions' }) %>

<div class="container py-5">
    <div class="row">
        <!-- Question Content -->
        <div class="col-lg-8">
            <div class="question-detail mb-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <span class="badge bg-<%= question.difficulty === 'Easy' ? 'success' : question.difficulty === 'Medium' ? 'warning' : 'danger' %> me-2">
                            <%= question.difficulty %>
                        </span>
                        <span class="badge bg-secondary me-2">
                            <i class="fas fa-tag me-1"></i><%= question.category ? question.category.name : 'Uncategorized' %>
                        </span>
                        <% if (question.year) { %>
                            <span class="badge bg-info me-2">
                                <i class="fas fa-calendar me-1"></i><%= question.year %>
                            </span>
                        <% } %>
                        <span class="badge bg-primary">
                            <i class="fas fa-star me-1"></i><%= question.marks %> Mark<%= question.marks > 1 ? 's' : '' %>
                        </span>
                    </div>
                    <div class="text-muted">
                        <small>
                            <i class="fas fa-eye me-1"></i><%= question.views || 0 %> views
                        </small>
                    </div>
                </div>

                <h1 class="question-title mb-4"><%= question.title %></h1>
                
                <div class="question-content mb-4">
                    <p class="lead"><%= question.content %></p>
                </div>

                <!-- Options -->
                <% if (question.options && question.options.length > 0) { %>
                    <div class="options-section mb-4">
                        <h5 class="mb-3">Options:</h5>
                        <div class="options-list">
                            <% question.options.forEach((option, index) => { %>
                                <div class="option-item mb-2 p-3 border rounded <%= option.isCorrect ? 'border-success bg-light' : 'border-secondary' %>">
                                    <div class="d-flex align-items-center">
                                        <span class="option-label me-3 fw-bold">
                                            <%= String.fromCharCode(65 + index) %>.
                                        </span>
                                        <span class="option-text"><%= option.text %></span>
                                        <% if (option.isCorrect) { %>
                                            <span class="badge bg-success ms-auto">
                                                <i class="fas fa-check me-1"></i>Correct
                                            </span>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- Explanation -->
                <% if (question.explanation) { %>
                    <div class="explanation-section mb-4">
                        <h5 class="mb-3">
                            <i class="fas fa-lightbulb text-warning me-2"></i>
                            Explanation
                        </h5>
                        <div class="explanation-content p-3 bg-light rounded">
                            <%= question.explanation %>
                        </div>
                    </div>
                <% } %>

                <!-- Tags -->
                <% if (question.tags && question.tags.length > 0) { %>
                    <div class="tags-section mb-4">
                        <h6 class="mb-2">Tags:</h6>
                        <div class="tags-list">
                            <% question.tags.forEach(tag => { %>
                                <span class="badge bg-outline-secondary me-1"><%= tag %></span>
                            <% }) %>
                        </div>
                    </div>
                <% } %>

                <!-- Author Info -->
                <div class="author-section mb-4 p-3 bg-light rounded">
                    <div class="d-flex align-items-center">
                        <div class="author-avatar me-3">
                            <i class="fas fa-user-circle fa-2x text-primary"></i>
                        </div>
                        <div class="author-info">
                            <h6 class="mb-1">
                                <a href="/users/<%= question.author.username %>" class="text-decoration-none">
                                    <%= question.author.firstName %> <%= question.author.lastName %>
                                </a>
                            </h6>
                            <small class="text-muted">
                                <i class="fas fa-clock me-1"></i>
                                <%= new Date(question.createdAt).toLocaleDateString() %>
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Like Button -->
                <div class="like-section mb-4">
                    <button class="btn btn-<%= user && question.likes && question.likes.some(like => like._id.toString() === user._id.toString()) ? 'primary' : 'outline-primary' %>" id="like-btn" onclick="toggleLike('<%= question._id %>')">
                        <i class="fas fa-heart me-2 <%= user && question.likes && question.likes.some(like => like._id.toString() === user._id.toString()) ? 'text-danger' : '' %>" id="like-icon"></i>
                        <span id="like-count"><%= question.likes ? question.likes.length : 0 %></span> Likes
                    </button>
                </div>
            </div>

            <!-- Answers Section -->
            <div class="answers-section mb-4">
                <h4 class="mb-3">
                    <i class="fas fa-comments me-2"></i>
                    Answers (<span id="answers-count">0</span>)
                </h4>

                <!-- Add Answer Form -->
                <% if (user) { %>
                    <div class="add-answer-form mb-4">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="mb-0">Add Your Answer</h6>
                            </div>
                            <div class="card-body">
                                <form id="answer-form">
                                    <div class="mb-3">
                                        <textarea class="form-control" id="answer-content" rows="4" 
                                            placeholder="Write your answer here..." required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-paper-plane me-2"></i>Post Answer
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="text-center mb-4">
                        <p class="text-muted">Login to add an answer</p>
                        <a href="/users/login" class="btn btn-primary">
                            <i class="fas fa-sign-in-alt me-2"></i>Login
                        </a>
                    </div>
                <% } %>

                <!-- Answers List -->
                <div id="answers-list">
                    <!-- Answers will be loaded here dynamically -->
                </div>

                <!-- Load More Answers -->
                <div id="load-more-answers" class="text-center" style="display: none;">
                    <button class="btn btn-outline-primary" onclick="loadMoreAnswers()">
                        <i class="fas fa-plus me-2"></i>Load More Answers
                    </button>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Question Actions -->
            <div class="card mb-4">
                <div class="card-header">
                    <h6 class="mb-0">Question Actions</h6>
                </div>
                <div class="card-body">
                    <% if (user) { %>
                        <div class="d-grid gap-2">
                            <button class="btn btn-<%= user && question.likes && question.likes.some(like => like._id.toString() === user._id.toString()) ? 'primary' : 'outline-primary' %>" id="sidebar-like-btn" onclick="toggleLike('<%= question._id %>')">
                                <i class="fas fa-heart me-2 <%= user && question.likes && question.likes.some(like => like._id.toString() === user._id.toString()) ? 'text-danger' : '' %>" id="sidebar-like-icon"></i>
                                <span id="sidebar-like-count"><%= question.likes ? question.likes.length : 0 %></span> Likes
                            </button>
                        </div>
                        
                        <% if (user._id === question.author._id.toString() || user.role === 'admin') { %>
                            <hr>
                            <div class="d-grid gap-2">
                                <a href="/questions/<%= question._id %>/edit" class="btn btn-warning">
                                    <i class="fas fa-edit me-2"></i>Edit Question
                                </a>
                                <button class="btn btn-danger" onclick="deleteQuestion('<%= question._id %>')">
                                    <i class="fas fa-trash me-2"></i>Delete Question
                                </button>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div class="text-center">
                            <p class="text-muted mb-3">Login to interact with this question</p>
                            <a href="/users/login" class="btn btn-primary">
                                <i class="fas fa-sign-in-alt me-2"></i>Login
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Related Questions -->
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0">Related Questions</h6>
                </div>
                <div class="card-body">
                    <p class="text-muted">Related questions will appear here</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let currentAnswersPage = 1;
let hasMoreAnswers = true;

// Load answers when page loads
document.addEventListener('DOMContentLoaded', function() {
    loadAnswers();
    
    // Handle answer form submission
    const answerForm = document.getElementById('answer-form');
    if (answerForm) {
        answerForm.addEventListener('submit', function(e) {
            e.preventDefault();
            submitAnswer();
        });
    }
});

function toggleLike(questionId) {
    fetch(`/questions/${questionId}/like`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            // Update all like buttons and counts
            const likeCounts = document.querySelectorAll('#like-count, #sidebar-like-count');
            const likeIcons = document.querySelectorAll('#like-icon, #sidebar-like-icon');
            const likeBtns = document.querySelectorAll('#like-btn, #sidebar-like-btn');
            
            likeCounts.forEach(count => count.textContent = data.likeCount);
            
            if (data.isLiked) {
                likeIcons.forEach(icon => icon.classList.add('text-danger'));
                likeBtns.forEach(btn => btn.classList.remove('btn-outline-primary'));
                likeBtns.forEach(btn => btn.classList.add('btn-primary'));
            } else {
                likeIcons.forEach(icon => icon.classList.remove('text-danger'));
                likeBtns.forEach(btn => btn.classList.remove('btn-primary'));
                likeBtns.forEach(btn => btn.classList.add('btn-outline-primary'));
            }
        }
    })
    .catch(error => console.error('Error:', error));
}

function loadAnswers() {
    const questionId = '<%= question._id %>';
    
    fetch(`/answers/question/${questionId}?page=${currentAnswersPage}`)
        .then(response => response.json())
        .then(data => {
            displayAnswers(data.answers);
            updateAnswersCount(data.total);
            hasMoreAnswers = currentAnswersPage < data.totalPages;
            updateLoadMoreButton();
        })
        .catch(error => console.error('Error loading answers:', error));
}

function displayAnswers(answers) {
    const answersList = document.getElementById('answers-list');
    
    if (currentAnswersPage === 1) {
        answersList.innerHTML = '';
    }
    
    answers.forEach(answer => {
        const answerHtml = createAnswerHtml(answer);
        answersList.innerHTML += answerHtml;
    });
}

function createAnswerHtml(answer) {
    const isAccepted = answer.isAccepted ? 'border-success bg-light' : 'border-secondary';
    const acceptedBadge = answer.isAccepted ? 
        '<span class="badge bg-success ms-2"><i class="fas fa-check me-1"></i>Accepted</span>' : '';
    
    const currentUserId = '<%= user ? user._id : "" %>';
    const currentUserRole = '<%= user ? user.role : "" %>';
    const questionAuthorId = '<%= question.author._id %>';
    
    const canAccept = currentUserId && currentUserId === questionAuthorId && !answer.isAccepted;
    const acceptButton = canAccept ? 
        `<button class="btn btn-sm btn-outline-success" onclick="acceptAnswer('${answer._id}')">
            <i class="fas fa-check me-1"></i>Accept
        </button>` : '';
    
    const canEdit = currentUserId && (currentUserId === answer.author._id || currentUserRole === 'admin');
    const editButton = canEdit ? 
        `<button class="btn btn-sm btn-outline-warning me-2" onclick="editAnswer('${answer._id}')">
            <i class="fas fa-edit me-1"></i>Edit
        </button>` : '';
    
    const deleteButton = canEdit ? 
        `<button class="btn btn-sm btn-outline-danger" onclick="deleteAnswer('${answer._id}')">
            <i class="fas fa-trash me-1"></i>Delete
        </button>` : '';
    
    return `
        <div class="answer-item mb-3 p-3 border rounded ${isAccepted}" data-answer-id="${answer._id}">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div class="answer-author">
                    <strong>${answer.author.firstName} ${answer.author.lastName}</strong>
                    ${acceptedBadge}
                </div>
                <div class="answer-actions">
                    ${editButton}
                    ${deleteButton}
                    ${acceptButton}
                </div>
            </div>
            <div class="answer-content mb-2">
                ${answer.content}
            </div>
            <div class="answer-footer d-flex justify-content-between align-items-center">
                <div class="answer-meta">
                    <small class="text-muted">
                        <i class="fas fa-clock me-1"></i>
                        ${new Date(answer.createdAt).toLocaleDateString()}
                    </small>
                </div>
                <div class="answer-likes">
                    <button class="btn btn-sm btn-outline-primary" onclick="toggleAnswerLike('${answer._id}')">
                        <i class="fas fa-heart me-1" id="answer-like-icon-${answer._id}"></i>
                        <span id="answer-like-count-${answer._id}">${answer.likeCount || 0}</span>
                    </button>
                </div>
            </div>
        </div>
    `;
}

function updateAnswersCount(total) {
    document.getElementById('answers-count').textContent = total;
}

function updateLoadMoreButton() {
    const loadMoreBtn = document.getElementById('load-more-answers');
    if (hasMoreAnswers) {
        loadMoreBtn.style.display = 'block';
    } else {
        loadMoreBtn.style.display = 'none';
    }
}

function loadMoreAnswers() {
    currentAnswersPage++;
    loadAnswers();
}

function submitAnswer() {
    const content = document.getElementById('answer-content').value.trim();
    if (!content) return;
    
    const questionId = '<%= question._id %>';
    
    fetch('/answers', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            content: content,
            questionId: questionId
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            document.getElementById('answer-content').value = '';
            currentAnswersPage = 1;
            loadAnswers();
        } else {
            alert(data.error || 'Failed to post answer');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Failed to post answer');
    });
}

function toggleAnswerLike(answerId) {
    fetch(`/answers/${answerId}/like`, {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        }
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            const likeCount = document.getElementById(`answer-like-count-${answerId}`);
            const likeIcon = document.getElementById(`answer-like-icon-${answerId}`);
            
            likeCount.textContent = data.likeCount;
            
            if (data.isLiked) {
                likeIcon.classList.add('text-danger');
            } else {
                likeIcon.classList.remove('text-danger');
            }
        }
    })
    .catch(error => console.error('Error:', error));
}

function acceptAnswer(answerId) {
    if (confirm('Accept this answer as the best answer?')) {
        fetch(`/answers/${answerId}/accept`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                loadAnswers(); // Reload to show updated status
            } else {
                alert(data.error || 'Failed to accept answer');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to accept answer');
        });
    }
}

function editAnswer(answerId) {
    const answerItem = document.querySelector(`[data-answer-id="${answerId}"]`);
    const contentDiv = answerItem.querySelector('.answer-content');
    const currentContent = contentDiv.textContent.trim();
    
    contentDiv.innerHTML = `
        <textarea class="form-control mb-2" rows="3">${currentContent}</textarea>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-primary" onclick="saveAnswerEdit('${answerId}')">
                <i class="fas fa-save me-1"></i>Save
            </button>
            <button class="btn btn-sm btn-secondary" onclick="cancelAnswerEdit('${answerId}')">
                <i class="fas fa-times me-1"></i>Cancel
            </button>
        </div>
    `;
}

function saveAnswerEdit(answerId) {
    const answerItem = document.querySelector(`[data-answer-id="${answerId}"]`);
    const textarea = answerItem.querySelector('textarea');
    const newContent = textarea.value.trim();
    
    if (!newContent) return;
    
    fetch(`/answers/${answerId}`, {
        method: 'PUT',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            content: newContent
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            loadAnswers(); // Reload to show updated content
        } else {
            alert(data.error || 'Failed to update answer');
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('Failed to update answer');
    });
}

function cancelAnswerEdit(answerId) {
    loadAnswers(); // Reload to restore original content
}

function deleteAnswer(answerId) {
    if (confirm('Are you sure you want to delete this answer?')) {
        fetch(`/answers/${answerId}`, {
            method: 'DELETE'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                loadAnswers(); // Reload to remove deleted answer
            } else {
                alert(data.error || 'Failed to delete answer');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Failed to delete answer');
        });
    }
}

function deleteQuestion(questionId) {
    if (confirm('Are you sure you want to delete this question? This action cannot be undone.')) {
        fetch(`/questions/${questionId}`, {
            method: 'DELETE'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                window.location.href = '/questions';
            }
        })
        .catch(error => console.error('Error:', error));
    }
}
</script>

<%- include('../partials/footer') %>
