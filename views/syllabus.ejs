<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GATE Syllabus - GATE Question Bank</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        .syllabus-section {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            border-left: 4px solid #007bff;
        }
        
        .syllabus-section h3 {
            color: #007bff;
            margin-bottom: 15px;
        }
        
        .topic-list {
            list-style: none;
            padding-left: 0;
        }
        
        .topic-list li {
            padding: 8px 0;
            border-bottom: 1px solid #e9ecef;
        }
        
        .topic-list li:last-child {
            border-bottom: none;
        }
        
        .topic-list li i {
            color: #28a745;
            margin-right: 10px;
        }
        
        .subject-card {
            transition: transform 0.2s;
            cursor: pointer;
        }
        
        .subject-card:hover {
            transform: translateY(-5px);
        }
        
        .hero-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 80px 0 60px 0;
            margin-bottom: 40px;
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary fixed-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="fas fa-graduation-cap me-2"></i>
                GATE Question Bank
            </a>
            
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/"><i class="fas fa-home me-1"></i>Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/questions"><i class="fas fa-question-circle me-1"></i>Questions</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/categories"><i class="fas fa-tags me-1"></i>Categories</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/syllabus"><i class="fas fa-book me-1"></i>Syllabus</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/marking-scheme"><i class="fas fa-chart-bar me-1"></i>Marking Scheme</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/about"><i class="fas fa-info-circle me-1"></i>About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/contact"><i class="fas fa-envelope me-1"></i>Contact</a>
                    </li>
                </ul>
                
                <!-- Search Form -->
                <form class="d-flex me-3" action="/search" method="GET">
                    <div class="input-group">
                        <input class="form-control" type="search" name="q" placeholder="Search questions..." aria-label="Search">
                        <button class="btn btn-outline-light" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>
                
                <!-- User Menu -->
                <ul class="navbar-nav">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle me-1"></i><%= user.firstName %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/users/profile">
                                    <i class="fas fa-user me-2"></i>Profile
                                </a></li>
                                <li><a class="dropdown-item" href="/questions/create">
                                    <i class="fas fa-plus me-2"></i>Add Question
                                </a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/users/logout">
                                    <i class="fas fa-sign-out-alt me-2"></i>Logout
                                </a></li>
                            </ul>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/users/login">
                                <i class="fas fa-sign-in-alt me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/users/register">
                                <i class="fas fa-user-plus me-1"></i>Register
                            </a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center">
                    <h1 class="display-4 fw-bold mb-4">
                        <i class="fas fa-book-open me-3"></i>
                        GATE Exam Syllabus
                    </h1>
                    <p class="lead mb-0">
                        Comprehensive coverage of all subjects and topics for the Graduate Aptitude Test in Engineering
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <main class="main-content" style="margin-top: 20px;">
        <div class="container">
            <!-- Computer Science & Information Technology -->
            <div class="syllabus-section">
                <h3><i class="fas fa-laptop-code me-2"></i>Computer Science & Information Technology (CS)</h3>
                <div class="row">
                    <div class="col-md-6">
                        <h5>Engineering Mathematics</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Linear Algebra</li>
                            <li><i class="fas fa-check-circle"></i>Calculus</li>
                            <li><i class="fas fa-check-circle"></i>Differential Equations</li>
                            <li><i class="fas fa-check-circle"></i>Numerical Methods</li>
                            <li><i class="fas fa-check-circle"></i>Probability & Statistics</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Digital Logic</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Boolean Algebra</li>
                            <li><i class="fas fa-check-circle"></i>Combinational Circuits</li>
                            <li><i class="fas fa-check-circle"></i>Sequential Circuits</li>
                            <li><i class="fas fa-check-circle"></i>Number Systems</li>
                        </ul>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Computer Organization & Architecture</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Machine Instructions</li>
                            <li><i class="fas fa-check-circle"></i>Memory Hierarchy</li>
                            <li><i class="fas fa-check-circle"></i>Pipelining</li>
                            <li><i class="fas fa-check-circle"></i>Cache Memory</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Programming & Data Structures</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Arrays, Linked Lists</li>
                            <li><i class="fas fa-check-circle"></i>Stacks, Queues</li>
                            <li><i class="fas fa-check-circle"></i>Trees, Graphs</li>
                            <li><i class="fas fa-check-circle"></i>Sorting & Searching</li>
                        </ul>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Algorithms</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Analysis of Algorithms</li>
                            <li><i class="fas fa-check-circle"></i>Divide & Conquer</li>
                            <li><i class="fas fa-check-circle"></i>Dynamic Programming</li>
                            <li><i class="fas fa-check-circle"></i>Greedy Algorithms</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Operating Systems</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Process Management</li>
                            <li><i class="fas fa-check-circle"></i>Memory Management</li>
                            <li><i class="fas fa-check-circle"></i>File Systems</li>
                            <li><i class="fas fa-check-circle"></i>Deadlocks</li>
                        </ul>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Databases</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>ER Model</li>
                            <li><i class="fas fa-check-circle"></i>Relational Algebra</li>
                            <li><i class="fas fa-check-circle"></i>SQL</li>
                            <li><i class="fas fa-check-circle"></i>Normalization</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Computer Networks</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>OSI Model</li>
                            <li><i class="fas fa-check-circle"></i>TCP/IP</li>
                            <li><i class="fas fa-check-circle"></i>Routing Algorithms</li>
                            <li><i class="fas fa-check-circle"></i>Network Security</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Electronics & Communication Engineering -->
            <div class="syllabus-section">
                <h3><i class="fas fa-broadcast-tower me-2"></i>Electronics & Communication Engineering (EC)</h3>
                <div class="row">
                    <div class="col-md-6">
                        <h5>Engineering Mathematics</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Linear Algebra</li>
                            <li><i class="fas fa-check-circle"></i>Calculus</li>
                            <li><i class="fas fa-check-circle"></i>Differential Equations</li>
                            <li><i class="fas fa-check-circle"></i>Complex Variables</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Networks</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Network Theorems</li>
                            <li><i class="fas fa-check-circle"></i>Transient Analysis</li>
                            <li><i class="fas fa-check-circle"></i>AC Analysis</li>
                            <li><i class="fas fa-check-circle"></i>Two-Port Networks</li>
                        </ul>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Electronic Devices</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Semiconductor Physics</li>
                            <li><i class="fas fa-check-circle"></i>Diodes & Transistors</li>
                            <li><i class="fas fa-check-circle"></i>MOSFETs</li>
                            <li><i class="fas fa-check-circle"></i>Optoelectronic Devices</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Analog Circuits</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Amplifiers</li>
                            <li><i class="fas fa-check-circle"></i>Oscillators</li>
                            <li><i class="fas fa-check-circle"></i>Operational Amplifiers</li>
                            <li><i class="fas fa-check-circle"></i>Filters</li>
                        </ul>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Digital Circuits</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Boolean Algebra</li>
                            <li><i class="fas fa-check-circle"></i>Combinational Circuits</li>
                            <li><i class="fas fa-check-circle"></i>Sequential Circuits</li>
                            <li><i class="fas fa-check-circle"></i>ADCs & DACs</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Communication Systems</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Analog Modulation</li>
                            <li><i class="fas fa-check-circle"></i>Digital Modulation</li>
                            <li><i class="fas fa-check-circle"></i>Information Theory</li>
                            <li><i class="fas fa-check-circle"></i>Noise</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Electrical Engineering -->
            <div class="syllabus-section">
                <h3><i class="fas fa-bolt me-2"></i>Electrical Engineering (EE)</h3>
                <div class="row">
                    <div class="col-md-6">
                        <h5>Engineering Mathematics</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Linear Algebra</li>
                            <li><i class="fas fa-check-circle"></i>Calculus</li>
                            <li><i class="fas fa-check-circle"></i>Differential Equations</li>
                            <li><i class="fas fa-check-circle"></i>Complex Variables</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Electric Circuits</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Network Theorems</li>
                            <li><i class="fas fa-check-circle"></i>Transient Analysis</li>
                            <li><i class="fas fa-check-circle"></i>AC Analysis</li>
                            <li><i class="fas fa-check-circle"></i>Three-Phase Circuits</li>
                        </ul>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Electromagnetic Fields</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Electrostatics</li>
                            <li><i class="fas fa-check-circle"></i>Magnetostatics</li>
                            <li><i class="fas fa-check-circle"></i>Maxwell's Equations</li>
                            <li><i class="fas fa-check-circle"></i>Wave Propagation</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Electrical Machines</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Transformers</li>
                            <li><i class="fas fa-check-circle"></i>DC Machines</li>
                            <li><i class="fas fa-check-circle"></i>Induction Motors</li>
                            <li><i class="fas fa-check-circle"></i>Synchronous Machines</li>
                        </ul>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Power Systems</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Power Generation</li>
                            <li><i class="fas fa-check-circle"></i>Transmission Lines</li>
                            <li><i class="fas fa-check-circle"></i>Power Distribution</li>
                            <li><i class="fas fa-check-circle"></i>Fault Analysis</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Control Systems</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Transfer Functions</li>
                            <li><i class="fas fa-check-circle"></i>Time Response</li>
                            <li><i class="fas fa-check-circle"></i>Stability Analysis</li>
                            <li><i class="fas fa-check-circle"></i>Root Locus</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Mechanical Engineering -->
            <div class="syllabus-section">
                <h3><i class="fas fa-cogs me-2"></i>Mechanical Engineering (ME)</h3>
                <div class="row">
                    <div class="col-md-6">
                        <h5>Engineering Mathematics</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Linear Algebra</li>
                            <li><i class="fas fa-check-circle"></i>Calculus</li>
                            <li><i class="fas fa-check-circle"></i>Differential Equations</li>
                            <li><i class="fas fa-check-circle"></i>Numerical Methods</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Engineering Mechanics</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Statics</li>
                            <li><i class="fas fa-check-circle"></i>Dynamics</li>
                            <li><i class="fas fa-check-circle"></i>Mechanics of Materials</li>
                            <li><i class="fas fa-check-circle"></i>Strength of Materials</li>
                        </ul>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Thermodynamics</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Laws of Thermodynamics</li>
                            <li><i class="fas fa-check-circle"></i>Properties of Substances</li>
                            <li><i class="fas fa-check-circle"></i>Power Cycles</li>
                            <li><i class="fas fa-check-circle"></i>Refrigeration Cycles</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Fluid Mechanics</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Fluid Properties</li>
                            <li><i class="fas fa-check-circle"></i>Fluid Statics</li>
                            <li><i class="fas fa-check-circle"></i>Fluid Dynamics</li>
                            <li><i class="fas fa-check-circle"></i>Boundary Layer Theory</li>
                        </ul>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Machine Design</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Design of Machine Elements</li>
                            <li><i class="fas fa-check-circle"></i>Gears & Bearings</li>
                            <li><i class="fas fa-check-circle"></i>Shafts & Couplings</li>
                            <li><i class="fas fa-check-circle"></i>Fasteners</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Manufacturing</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Metal Casting</li>
                            <li><i class="fas fa-check-circle"></i>Forming Processes</li>
                            <li><i class="fas fa-check-circle"></i>Machining Processes</li>
                            <li><i class="fas fa-check-circle"></i>Welding</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Civil Engineering -->
            <div class="syllabus-section">
                <h3><i class="fas fa-building me-2"></i>Civil Engineering (CE)</h3>
                <div class="row">
                    <div class="col-md-6">
                        <h5>Engineering Mathematics</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Linear Algebra</li>
                            <li><i class="fas fa-check-circle"></i>Calculus</li>
                            <li><i class="fas fa-check-circle"></i>Differential Equations</li>
                            <li><i class="fas fa-check-circle"></i>Numerical Methods</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Structural Analysis</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Statically Determinate Structures</li>
                            <li><i class="fas fa-check-circle"></i>Statically Indeterminate Structures</li>
                            <li><i class="fas fa-check-circle"></i>Influence Lines</li>
                            <li><i class="fas fa-check-circle"></i>Matrix Methods</li>
                        </ul>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Concrete Structures</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Reinforced Concrete</li>
                            <li><i class="fas fa-check-circle"></i>Prestressed Concrete</li>
                            <li><i class="fas fa-check-circle"></i>Design of Beams</li>
                            <li><i class="fas fa-check-circle"></i>Design of Columns</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Steel Structures</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Design of Tension Members</li>
                            <li><i class="fas fa-check-circle"></i>Design of Compression Members</li>
                            <li><i class="fas fa-check-circle"></i>Design of Beams</li>
                            <li><i class="fas fa-check-circle"></i>Connections</li>
                        </ul>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <h5>Geotechnical Engineering</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Soil Mechanics</li>
                            <li><i class="fas fa-check-circle"></i>Foundation Engineering</li>
                            <li><i class="fas fa-check-circle"></i>Slope Stability</li>
                            <li><i class="fas fa-check-circle"></i>Retaining Structures</li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h5>Transportation Engineering</h5>
                        <ul class="topic-list">
                            <li><i class="fas fa-check-circle"></i>Highway Planning</li>
                            <li><i class="fas fa-check-circle"></i>Traffic Engineering</li>
                            <li><i class="fas fa-check-circle"></i>Pavement Design</li>
                            <li><i class="fas fa-check-circle"></i>Railway Engineering</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Information Box -->
            <div class="alert alert-info mt-4">
                <h5><i class="fas fa-info-circle me-2"></i>Important Notes</h5>
                <ul class="mb-0">
                    <li>The syllabus is subject to change. Please refer to the official GATE website for the most current information.</li>
                    <li>Each subject has different weightage in the exam. Focus on high-weightage topics.</li>
                    <li>Practice previous year questions to understand the exam pattern and difficulty level.</li>
                    <li>Time management is crucial - allocate time based on topic weightage and your strengths.</li>
                </ul>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5><i class="fas fa-graduation-cap me-2"></i>GATE Question Bank</h5>
                    <p class="mb-0">Community-driven database of high-quality GATE exam questions.</p>
                </div>
                <div class="col-md-3">
                    <h6>Quick Links</h6>
                    <ul class="list-unstyled">
                        <li><a href="/" class="text-light text-decoration-none">Home</a></li>
                        <li><a href="/questions" class="text-light text-decoration-none">Questions</a></li>
                        <li><a href="/categories" class="text-light text-decoration-none">Categories</a></li>
                        <li><a href="/syllabus" class="text-light text-decoration-none">Syllabus</a></li>
                        <li><a href="/marking-scheme" class="text-light text-decoration-none">Marking Scheme</a></li>
                        <li><a href="/about" class="text-light text-decoration-none">About</a></li>
                    </ul>
                </div>
                <div class="col-md-3">
                    <h6>Connect</h6>
