<%- include('../partials/header', { title: 'Profile - GATE Question Bank' }) %>

<div class="container py-5">
    <div class="row">
        <!-- Profile Sidebar -->
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    <div class="profile-avatar mb-3">
                        <i class="fas fa-user-circle fa-5x text-primary"></i>
                    </div>
                    <h4 class="card-title"><%= profile.firstName %> <%= profile.lastName %></h4>
                    <p class="text-muted">@<%= profile.username %></p>
                    
                    <% if (profile.institution) { %>
                        <p class="text-muted mb-2">
                            <i class="fas fa-university me-2"></i>
                            <%= profile.institution %>
                        </p>
                    <% } %>
                    
                    <% if (profile.bio) { %>
                        <p class="text-muted mb-3"><%= profile.bio %></p>
                    <% } %>
                    
                    <div class="profile-stats mb-3">
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="stat-item">
                                    <h5 class="fw-bold text-primary"><%= profile.questionsSubmitted || 0 %></h5>
                                    <small class="text-muted">Questions</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-item">
                                    <h5 class="fw-bold text-success"><%= profile.reputation || 0 %></h5>
                                    <small class="text-muted">Reputation</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-item">
                                    <h5 class="fw-bold text-info"><%= profile.lastActive ? 'Active' : 'Inactive' %></h5>
                                    <small class="text-muted">Status</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <a href="/users/profile/edit" class="btn btn-outline-primary">
                            <i class="fas fa-edit me-2"></i>Edit Profile
                        </a>
                        <button class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                            <i class="fas fa-key me-2"></i>Change Password
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Expertise -->
            <% if (profile.expertise && profile.expertise.length > 0) { %>
                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-tags text-info me-2"></i>
                            Areas of Expertise
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-1">
                            <% profile.expertise.forEach(exp => { %>
                                <span class="badge bg-light text-dark"><%= exp %></span>
                            <% }) %>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>

        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Profile Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1">My Questions</h2>
                    <p class="text-muted mb-0">Questions you've contributed to the community</p>
                </div>
                <a href="/questions/create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Add Question
                </a>
            </div>

            <!-- Questions List -->
            <% if (questions && questions.length > 0) { %>
                <div class="row">
                    <% questions.forEach(question => { %>
                        <div class="col-12 mb-3">
                            <div class="question-card h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="badge bg-<%= question.difficulty === 'Easy' ? 'success' : question.difficulty === 'Medium' ? 'warning' : 'danger' %> me-2">
                                                <%= question.difficulty %>
                                            </span>
                                            <span class="badge bg-secondary me-2">
                                                <i class="fas fa-tag me-1"></i>
                                                <%= question.category ? question.category.name : 'Uncategorized' %>
                                            </span>
                                            <% if (question.isApproved === false) { %>
                                                <span class="badge bg-warning">
                                                    <i class="fas fa-clock me-1"></i>Pending Approval
                                                </span>
                                            <% } %>
                                        </div>
                                        <div class="text-muted">
                                            <small>
                                                <i class="fas fa-eye me-1"></i><%= question.views || 0 %>
                                            </small>
                                        </div>
                                    </div>
                                    
                                    <h5 class="card-title">
                                        <a href="/questions/<%= question._id %>" class="text-decoration-none stretched-link">
                                            <%= question.title %>
                                        </a>
                                    </h5>
                                    
                                    <p class="card-text text-muted">
                                        <%= question.content.substring(0, 150) %>...
                                    </p>
                                    
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="question-meta">
                                            <small class="text-muted">
                                                <i class="fas fa-calendar me-1"></i>
                                                <%= new Date(question.createdAt).toLocaleDateString() %>
                                            </small>
                                            <% if (question.year) { %>
                                                <small class="text-muted ms-2">
                                                    <i class="fas fa-calendar-alt me-1"></i><%= question.year %>
                                                </small>
                                            <% } %>
                                            <% if (question.marks) { %>
                                                <small class="text-muted ms-2">
                                                    <i class="fas fa-star me-1"></i><%= question.marks %> Mark<%= question.marks > 1 ? 's' : '' %>
                                                </small>
                                            <% } %>
                                        </div>
                                        
                                        <div class="question-actions">
                                            <a href="/questions/<%= question._id %>/edit" class="btn btn-outline-warning btn-sm me-2">
                                                <i class="fas fa-edit me-1"></i>Edit
                                            </a>
                                            <button class="btn btn-outline-danger btn-sm" onclick="deleteQuestion('<%= question._id %>')">
                                                <i class="fas fa-trash me-1"></i>Delete
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="fas fa-question-circle fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No questions yet</h4>
                    <p class="text-muted">Start contributing to the community by adding your first question!</p>
                    <a href="/questions/create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add Your First Question
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Change Password Modal -->
<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="changePasswordModalLabel">Change Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="changePasswordForm">
                    <div class="mb-3">
                        <label for="currentPassword" class="form-label">Current Password</label>
                        <input type="password" class="form-control" id="currentPassword" name="currentPassword" required>
                    </div>
                    <div class="mb-3">
                        <label for="newPassword" class="form-label">New Password</label>
                        <input type="password" class="form-control" id="newPassword" name="newPassword" required>
                    </div>
                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label">Confirm New Password</label>
                        <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="changePassword()">Change Password</button>
            </div>
        </div>
    </div>
</div>

<script>
function deleteQuestion(questionId) {
    if (confirm('Are you sure you want to delete this question? This action cannot be undone.')) {
        fetch(`/questions/${questionId}`, {
            method: 'DELETE'
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                location.reload();
            } else {
                alert('Failed to delete question: ' + data.error);
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('An error occurred while deleting the question');
        });
    }
}

function changePassword() {
    const currentPassword = document.getElementById('currentPassword').value;
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    
    if (newPassword !== confirmPassword) {
        alert('New passwords do not match');
        return;
    }
    
    if (newPassword.length < 6) {
        alert('New password must be at least 6 characters long');
        return;
    }
    
    fetch('/users/change-password', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
        },
        body: JSON.stringify({
            currentPassword,
            newPassword
        })
    })
    .then(response => response.json())
    .then(data => {
        if (data.success) {
            alert('Password changed successfully!');
            document.getElementById('changePasswordModal').querySelector('.btn-close').click();
            document.getElementById('changePasswordForm').reset();
        } else {
            alert('Failed to change password: ' + data.error);
        }
    })
    .catch(error => {
        console.error('Error:', error);
        alert('An error occurred while changing the password');
    });
}
</script>

<style>
.question-card {
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    border: 1px solid #e9ecef;
}

.question-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.profile-avatar {
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.stat-item {
    padding: 0.5rem;
}

.stat-item h5 {
    margin-bottom: 0.25rem;
}
</style>

<%- include('../partials/footer') %>
