<%- include('../partials/header', { title: profile.username + ' - GATE Question Bank' }) %>

<div class="container py-5">
    <div class="row">
        <!-- Profile Sidebar -->
        <div class="col-lg-4 mb-4">
            <div class="card">
                <div class="card-body text-center">
                    <div class="profile-avatar mb-3">
                        <i class="fas fa-user-circle fa-5x text-primary"></i>
                    </div>
                    <h4 class="card-title"><%= profile.firstName %> <%= profile.lastName %></h4>
                    <p class="text-muted">@<%= profile.username %></p>
                    
                    <% if (profile.institution) { %>
                        <p class="text-muted mb-2">
                            <i class="fas fa-university me-2"></i>
                            <%= profile.institution %>
                        </p>
                    <% } %>
                    
                    <% if (profile.bio) { %>
                        <p class="text-muted mb-3"><%= profile.bio %></p>
                    <% } %>
                    
                    <div class="profile-stats mb-3">
                        <div class="row text-center">
                            <div class="col-4">
                                <div class="stat-item">
                                    <h5 class="fw-bold text-primary"><%= profile.questionsSubmitted || 0 %></h5>
                                    <small class="text-muted">Questions</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-item">
                                    <h5 class="fw-bold text-success"><%= profile.reputation || 0 %></h5>
                                    <small class="text-muted">Reputation</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="stat-item">
                                    <h5 class="fw-bold text-info">
                                        <%= profile.lastActive ? new Date(profile.lastActive).toLocaleDateString() : 'Never' %>
                                    </h5>
                                    <small class="text-muted">Last Active</small>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <% if (user && user._id === profile._id.toString()) { %>
                            <a href="/users/profile" class="btn btn-primary">
                                <i class="fas fa-user me-2"></i>My Profile
                            </a>
                        <% } else if (user) { %>
                            <button class="btn btn-outline-primary" onclick="followUser('<%= profile._id %>')">
                                <i class="fas fa-user-plus me-2"></i>Follow
                            </button>
                        <% } else { %>
                            <a href="/users/login" class="btn btn-primary">
                                <i class="fas fa-sign-in-alt me-2"></i>Login to Follow
                            </a>
                        <% } %>
                    </div>
                </div>
            </div>
            
            <!-- Expertise -->
            <% if (profile.expertise && profile.expertise.length > 0) { %>
                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0">
                            <i class="fas fa-tags text-info me-2"></i>
                            Areas of Expertise
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-1">
                            <% profile.expertise.forEach(exp => { %>
                                <span class="badge bg-light text-dark"><%= exp %></span>
                            <% }) %>
                        </div>
                    </div>
                </div>
            <% } %>
            
            <!-- Member Since -->
            <div class="card mt-3">
                <div class="card-body text-center">
                    <h6 class="text-muted mb-2">Member Since</h6>
                    <p class="mb-0">
                        <i class="fas fa-calendar text-primary me-2"></i>
                        <%= new Date(profile.createdAt).toLocaleDateString('en-US', { 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric' 
                        }) %>
                    </p>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-8">
            <!-- Profile Header -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1"><%= profile.firstName %>'s Questions</h2>
                    <p class="text-muted mb-0">Questions contributed by this community member</p>
                </div>
                <div class="d-flex gap-2">
                    <a href="/questions" class="btn btn-outline-primary">
                        <i class="fas fa-question-circle me-2"></i>All Questions
                    </a>
                    <a href="/categories" class="btn btn-outline-info">
                        <i class="fas fa-tags me-2"></i>Categories
                    </a>
                </div>
            </div>

            <!-- Questions List -->
            <% if (questions && questions.length > 0) { %>
                <div class="row">
                    <% questions.forEach(question => { %>
                        <div class="col-12 mb-3">
                            <div class="question-card h-100">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <span class="badge bg-<%= question.difficulty === 'Easy' ? 'success' : question.difficulty === 'Medium' ? 'warning' : 'danger' %> me-2">
                                                <%= question.difficulty %>
                                            </span>
                                            <span class="badge bg-secondary me-2">
                                                <i class="fas fa-tag me-1"></i>
                                                <%= question.category ? question.category.name : 'Uncategorized' %>
                                            </span>
                                            <% if (question.isApproved === false) { %>
                                                <span class="badge bg-warning">
                                                    <i class="fas fa-clock me-1"></i>Pending Approval
                                                </span>
                                            <% } %>
                                        </div>
                                        <div class="text-muted">
                                            <small>
                                                <i class="fas fa-eye me-1"></i><%= question.views || 0 %>
                                            </small>
                                        </div>
                                    </div>
                                    
                                    <h5 class="card-title">
                                        <a href="/questions/<%= question._id %>" class="text-decoration-none stretched-link">
                                            <%= question.title %>
                                        </a>
                                    </h5>
                                    
                                    <p class="card-text text-muted">
                                        <%= question.content.substring(0, 150) %>...
                                    </p>
                                    
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="question-meta">
                                            <small class="text-muted">
                                                <i class="fas fa-calendar me-1"></i>
                                                <%= new Date(question.createdAt).toLocaleDateString() %>
                                            </small>
                                            <% if (question.year) { %>
                                                <small class="text-muted ms-2">
                                                    <i class="fas fa-calendar-alt me-1"></i><%= question.year %>
                                                </small>
                                            <% } %>
                                            <% if (question.marks) { %>
                                                <small class="text-muted ms-2">
                                                    <i class="fas fa-star me-1"></i><%= question.marks %> Mark<%= question.marks > 1 ? 's' : '' %>
                                                </small>
                                            <% } %>
                                        </div>
                                        
                                        <div class="question-actions">
                                            <a href="/questions/<%= question._id %>" class="btn btn-primary btn-sm">
                                                <i class="fas fa-eye me-1"></i>View
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="fas fa-question-circle fa-3x text-muted mb-3"></i>
                    <h4 class="text-muted">No questions yet</h4>
                    <p class="text-muted"><%= profile.firstName %> hasn't contributed any questions yet.</p>
                    <% if (user && user._id === profile._id.toString()) { %>
                        <a href="/questions/create" class="btn btn-primary">
                            <i class="fas fa-plus me-2"></i>Add Your First Question
                        </a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
function followUser(userId) {
    // This would be implemented if you want to add a follow system
    alert('Follow functionality coming soon!');
}
</script>

<style>
.question-card {
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    border: 1px solid #e9ecef;
}

.question-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.profile-avatar {
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.stat-item {
    padding: 0.5rem;
}

.stat-item h5 {
    margin-bottom: 0.25rem;
}
</style>

<%- include('../partials/footer') %>
